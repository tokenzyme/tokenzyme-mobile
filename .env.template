# Copy this file to .env and fill in the values.
#
#   cp .env.template .env
#
# .env is git-ignored, but note that it is declared as a Flutter asset in
# pubspec.yaml — it is PACKAGED INTO THE APP BUNDLE and anyone can extract it from a
# published APK or IPA. Treat everything here as public. Never put a private key, an
# API secret or a signing credential in this file.
#
# Every variable is required — lib/utils/env.dart throws at startup if one is missing.

# ---------------------------------------------------------------------------
# Backend services
# ---------------------------------------------------------------------------

# tokenzyme-core — GraphQL API and its comments WebSocket.
CORE_URL="http://localhost:3000"

# tokenzyme-indexer — trades and price WebSocket.
INDEXER_URL="http://localhost:3002"

# tokenzyme-app — the web client. The token chart is not implemented natively; it is
# loaded from <APP_URL>/tokens/<address>/chart inside a WebView.
# Use https in production: that WebView runs with JavaScript unrestricted.
APP_URL="http://localhost:3001"

# ---------------------------------------------------------------------------
# Wallet connection
# ---------------------------------------------------------------------------

# Reown (formerly WalletConnect) project ID, from https://dashboard.reown.com.
# Create your own — it is tied to an account and to its configured redirect URLs.
REOWN_PROJECT_ID=""

# ---------------------------------------------------------------------------
# Blockchain
# ---------------------------------------------------------------------------
# NETWORK and LAUNCHPAD_ADDRESS must describe the same network, and must match what
# tokenzyme-core and tokenzyme-indexer are pointed at. Uncomment one block.
# RPC endpoints and explorers per network live in lib/utils/reown.dart.

# Point this at YOUR OWN launchpad deployment. The addresses in the commented blocks
# below are the canonical Tokenzyme deployments, listed for reference only — using them
# means your build trades against Tokenzyme's launchpad, not yours.
NETWORK="testnet"
LAUNCHPAD_ADDRESS=""

# Reference: the Tokenzyme deployments
#
#   Sonic mainnet (chain ID 146)
#   NETWORK="mainnet"
#   LAUNCHPAD_ADDRESS="0x9E23D1354E30C2274D3f0Ae2D70c9324081A6E4c"
#
#   Sonic testnet (chain ID 14601)
#   NETWORK="testnet"
#   LAUNCHPAD_ADDRESS="0xcafD49ea48EFa63e94a8392Bb78924Ed1a26e702"
#
#   Sonic Blaze testnet (chain ID 57054, legacy)
#   NETWORK="testnet-legacy"
#   LAUNCHPAD_ADDRESS="0x9E23D1354E30C2274D3f0Ae2D70c9324081A6E4c"
